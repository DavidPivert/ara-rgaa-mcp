{
  "name": "ara-rgaa-mcp",
  "mcpName": "io.github.DavidPivert/ara-rgaa-mcp",
  "version": "2.0.1",
  "description": "Serveur MCP pour Ara — audits d'accessibilité RGAA 4.1 / MCP server for Ara, the French government RGAA 4.1 accessibility audit platform",
  "license": "EUPL-1.2",
  "author": "David Pivert",
  "type": "module",
  "bin": {
    "ara-rgaa-mcp": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidPivert/ara-rgaa-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/DavidPivert/ara-rgaa-mcp/issues"
  },
  "homepage": "https://github.com/DavidPivert/ara-rgaa-mcp#readme",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "model-context-protocol",
    "rgaa",
    "accessibility",
    "accessibilite",
    "a11y",
    "wcag",
    "ara",
    "audit",
    "claude"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
